# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).

# Chave da OpenAI. Se ficar vazia, o app roda em MODO DEMONSTRAÇÃO (respostas simuladas).
OPENAI_API_KEY=

# Modelo da OpenAI usado pelo Chip (pode trocar sem alterar código).
OPENAI_MODEL=gpt-4o-mini

# Conexão com o banco. No Render, use a "Internal Database URL" do PostgreSQL.
# Se ficar vazia, o app usa um arquivo SQLite local (performanceai.db) para desenvolvimento.
DATABASE_URL=

# Segredo usado para assinar os tokens de sessão (JWT). Use um valor longo e aleatório.
# Gere um com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo

# Validade do token de sessão, em horas.
JWT_EXPIRE_HOURS=72

# Limite de mensagens por mês do plano Gratuito (decisão do time: 20).
FREE_MONTHLY_LIMIT=20
